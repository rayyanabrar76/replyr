# ──────────────────────────────────────────────────────────────
# Replyr — environment variables
# Copy to .env.local and fill in
# ──────────────────────────────────────────────────────────────

# App ----------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase -----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# New dashboard provides a publishable key (sb_publishable_...) — use that here.
# Older projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY (eyJ...) instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider: "anthropic" | "google" -------------------------
LLM_PROVIDER=google
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Stripe -------------------------------------------------------
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Set up a webhook at /api/webhooks/stripe and copy the signing secret here
STRIPE_WEBHOOK_SECRET=
# Create a recurring price in Stripe and paste the price_xxx ID
STRIPE_PRICE_ID=

# Google OAuth (for Calendar booking) --------------------------
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${NEXT_PUBLIC_APP_URL}/api/auth/google-calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Resend) -----------------------------------------------
# Used for sending agent replies via email
RESEND_API_KEY=
# Domain configured for inbound email — must match what your provider routes to /api/webhooks/email
NEXT_PUBLIC_INBOUND_EMAIL_DOMAIN=inbound.replyr.app
# Shared secret for webhook auth — configure your email provider to send "Authorization: Bearer <this>"
INBOUND_EMAIL_WEBHOOK_SECRET=
